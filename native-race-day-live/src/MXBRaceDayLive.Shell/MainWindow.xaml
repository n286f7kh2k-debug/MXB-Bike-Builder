<Window x:Class="MXBRaceDayLive.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MXB Race Day Live"
        Width="1280" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/mxb_race_day_live.ico">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#061522" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MXB" Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="23"/>
                    <TextBlock Text="  RACE DAY LIVE" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Semibold" FontSize="18" VerticalAlignment="Center"/>
                    <Border Margin="18,0,0,0" Padding="10,4" CornerRadius="10" BorderBrush="#17405A" BorderThickness="1" Background="#081E2C">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MxbDot" Width="7" Height="7" Fill="#607887" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MxbStatusText" Text="MX Bikes: detecting…" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FeatureVersionText" Text="Profile v1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="MenuButton" Content="MENU  ☰" Click="MenuButton_Click"
                            Padding="15,8" Foreground="{StaticResource TextBrush}" Background="#0A2235"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="Hand">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppMenu" Background="#071A29" Foreground="#F2F7FB" BorderBrush="#155273">
                                <MenuItem Header="Check for Updates" Click="CheckForUpdates_Click"/>
                                <MenuItem Header="Launch MX Bikes" Click="LaunchMXBikes_Click"/>
                                <Separator/>
                                <MenuItem Header="Exit" Click="Exit_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl x:Name="FeatureHost"/>
            <Border x:Name="StartupOverlay" Background="#04101B" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="MXB RACE DAY LIVE" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="26" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StartupText" Text="Loading native profile…" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#061522" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="UpdateStatusText" Text="Native Windows build · automatic live updates enabled" Foreground="#688596" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Text="MXB Race Day Live" Foreground="#456275" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
